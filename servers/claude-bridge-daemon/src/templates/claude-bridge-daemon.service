[Unit]
Description=claude-bridge control-plane daemon
Documentation=https://github.com/michalekz/claude-bridge/blob/main/docs/architecture.md
After=default.target

[Service]
Type=simple
ExecStart=__NODE_BIN__ __DAEMON_BIN__ run
Restart=always
RestartSec=2s
StandardOutput=journal
StandardError=journal
Environment=NODE_ENV=production
Environment=LOG_LEVEL=info
# The directory holding the node that runs this daemon comes FIRST, because the
# `claude` binary lives beside it and systemd's default PATH has no nvm in it.
#
# v0.11.27, and it is the second instance in three days: 2026-08-08 was `node
# not found` when relaunching an MCP child, patched at that one call site;
# 2026-08-10 was `spawn claude ENOENT` in the busy probe, which meant the gate
# added after the 2026-08-09 double-compact incident had never once run — 9
# failed probes, 0 refusals. `tmux`, `systemctl` and `node` survived only
# because someone had symlinked them into a system directory, which is a
# property of that machine and not of this unit.
Environment=PATH=__NODE_DIR__:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Get out of the front row when the machine runs out of memory.
#
# 2026-08-13, measured after `earlyoom` killed ten processes in 2.8 s and this
# daemon was among them:
#
#     unset            adj 200  score 800   <- ranked ABOVE every big consumer
#     OOMScoreAdjust=0 adj 100  score 733
#     a 4.7 GB java    adj   0  score 765
#     a 7.2 GB agent   adj   0  score 774
#
# A bare child of the systemd user manager inherits 200 on this host, so the
# daemon — 62 MB — was a better kill candidate than a seven-gigabyte process.
# Killing it frees nothing and severs the control plane exactly when the machine
# is in trouble, which is when the team most needs to talk.
#
# WHY `0` AND NOT `-500`: they do the same thing. `user@<uid>.service` sets
# OOMScoreAdjust=100 and a user unit may not go below its manager, so both land
# on 100. Writing -500 would state a value this unit does not get, and a file
# that lies about its own effective value is worse than one that admits the
# floor.
#
# WHAT THIS IS NOT: protection. 733 is below the biggest consumers but still
# above a 2 GB process, and under sustained pressure earlyoom walks down to it
# anyway. `Restart=always` above is still what actually saves us; this only ends
# the absurdity of sacrificing the one process that holds no memory at all.
#
# ⚠ THIS FILE HAS A TWIN at `../../templates/`. Both are live; change together.
OOMScoreAdjust=0

[Install]
WantedBy=default.target
